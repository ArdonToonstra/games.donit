@using DonitGames.Core.JustOne

<div class="card">
    <div class="outcome">
        <span class="outcome-emoji" aria-hidden="true">🏁</span>
        <p class="outcome-title win">Spel afgelopen</p>
        <p class="outcome-sub">@View.CorrectCount van de @View.RoundsPlayed rondes goed geraden</p>
    </div>

    <ScoreTrack PipsRemaining="View.PipsRemaining" />

    @if (View.YouAreHost)
    {
        <div class="action-bar">
            <button type="button" class="btn btn-primary btn-lg btn-block" @onclick="() => OnNewGame.InvokeAsync()">
                Nieuw spel
            </button>
        </div>
    }
</div>

@code {
    [Parameter, EditorRequired]
    public JustOneView View { get; set; } = default!;

    [Parameter, EditorRequired]
    public EventCallback OnNewGame { get; set; }
}
