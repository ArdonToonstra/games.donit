@using DonitGames.Core.JustOne

@if (View.YouAreGuesser)
{
    <PeekShield Message="Wachten op de controle van de hints…" />
}
else
{
    <div class="card">
        <div class="card-header">
            <p class="eyebrow">Controle</p>
            <h1>🔍 Dubbele hints</h1>
            <p class="subtle">
                Precies gelijke hints vallen automatisch weg. Twijfelgevallen beslist de tafel zelf.
            </p>
        </div>

        <ClueList View="View" Clues="View.Clues" />

        @if (View.ReviewGroups.Count > 0)
        {
            <p class="eyebrow">Twijfelgevallen</p>
            @foreach (var group in View.ReviewGroups)
            {
                @* The words are what the table is actually judging, so the row leads with them —
                   the old version showed only the names, which asked everyone to scroll back up
                   and match names to clues before they could decide. *@
                <div class="review-group @(group.ManuallyCancelled ? "is-cancelled" : "")">
                    <div class="review-group-words">
                        @foreach (var seatId in group.SeatIds)
                        {
                            <span class="review-group-word">
                                @(View.Clues.FirstOrDefault(c => c.SeatId == seatId)?.Text ?? "?")
                                <small>@View.NameOf(seatId)</small>
                            </span>
                        }
                    </div>
                    <button type="button"
                        class="btn btn-outline-secondary btn-block @(group.ManuallyCancelled ? "is-on" : "")"
                        aria-pressed="@group.ManuallyCancelled.ToString().ToLowerInvariant()"
                        @onclick="() => OnToggleGroup.InvokeAsync(group.Index)">
                        @(group.ManuallyCancelled ? "✓ Vervallen — toch toelaten" : "Hetzelfde — laten vervallen")
                    </button>
                </div>
            }
        }

        @if (View.YouAreJudge)
        {
            @if (SurvivingCount == 0)
            {
                <p class="form-hint center">
                    Er blijft geen enkele hint over — de ronde gaat meteen naar het resultaat.
                </p>
            }
            <div class="action-bar">
                <button type="button" class="btn btn-primary btn-lg btn-block" @onclick="() => OnReveal.InvokeAsync()">
                    Tonen aan @(View.Guesser?.DisplayName ?? "de rader") (@SurvivorLabel)
                </button>
            </div>
        }
        else
        {
            <p class="subtle center">
                Wachten tot @(View.Players.FirstOrDefault(p => p.IsJudge)?.DisplayName ?? "de scheidsrechter") de hints vrijgeeft…
            </p>
        }
    </div>
}

@code {
    [Parameter, EditorRequired]
    public JustOneView View { get; set; } = default!;

    [Parameter, EditorRequired]
    public EventCallback<int> OnToggleGroup { get; set; }

    [Parameter, EditorRequired]
    public EventCallback OnReveal { get; set; }

    private int SurvivingCount => View.Clues.Count(c => !c.IsCancelled);

    private string SurvivorLabel => SurvivingCount == 1 ? "1 hint" : $"{SurvivingCount} hints";
}
