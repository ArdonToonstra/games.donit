@page "/"

<PageTitle>Spellen — donit</PageTitle>

<div class="container">
    <div class="card">
        <div class="card-header">
            <p class="eyebrow">Kies een spel</p>
            <h1>🎲 Spellen</h1>
            <p class="lead">Partyspellen voor op de bank. Eén telefoon of ieder z'n eigen — kies maar.</p>
        </div>

        <div class="menu-tile-grid">

            <a class="menu-tile" href="undercover/">
                <span class="menu-tile-emoji" aria-hidden="true">🎭</span>
                <span class="menu-tile-body">
                    <span class="menu-tile-name">Undercover</span>
                    <span class="menu-tile-meta">1 telefoon · 3–10 spelers</span>
                    <span class="menu-tile-desc">
                        Geef de telefoon door. Iedereen krijgt een geheim woord — behalve zij die dat niet krijgen.
                    </span>
                </span>
            </a>

            <a class="menu-tile" href="undercover-online">
                <span class="menu-tile-emoji" aria-hidden="true">🕵️</span>
                <span class="menu-tile-body">
                    <span class="menu-tile-name">Undercover — online</span>
                    <span class="menu-tile-meta">Ieder z'n telefoon · 3–10 spelers</span>
                    <span class="menu-tile-desc">Hetzelfde spel, maar iedereen doet mee op z'n eigen scherm.</span>
                </span>
            </a>

            <a class="menu-tile" href="just-one">
                <span class="menu-tile-emoji" aria-hidden="true">💡</span>
                <span class="menu-tile-body">
                    <span class="menu-tile-name">Just One</span>
                    <span class="menu-tile-meta">Ieder z'n telefoon · 3–8 spelers</span>
                    <span class="menu-tile-desc">
                        Samen raden. Schrijf één tip op — maar dubbele tips vallen weg.
                    </span>
                </span>
            </a>

        </div>
    </div>

    <div class="footer-links">
        <a href="https://github.com/ArdonToonstra/games.donit/issues" target="_blank" rel="noopener noreferrer">
            Feedback of een bug melden
        </a>
    </div>
</div>
